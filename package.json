{
  "name": "my-sesi-metne-donusturme",
  "version": "1.0.0",
  "description": "My Sesi Metne Dönüştürme - yerel ses/video/YouTube transkript uygulaması",
  "author": "Mustafa Yılmaz",
  "copyright": "© 2026 Mustafa Yılmaz. Tüm hakları saklıdır.",
  "license": "MIT",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && set ELECTRON_RUN_AS_NODE=&& set VITE_DEV_SERVER_URL=http://127.0.0.1:5173&& electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "test:electron": "npm run build && set ELECTRON_RUN_AS_NODE=&& electron scripts/electron-smoke.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "docx": "^9.1.1",
    "pdfkit": "^0.15.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.2",
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.mustafayilmaz.mysesimetnedonusturme",
    "productName": "My Sesi Metne Dönüştürme",
    "artifactName": "My-Sesi-Metne-Donusturme-Setup-x64.${ext}",
    "directories": {
      "output": "dist-electron-package"
    },
    "compression": "maximum",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "Tools/ffmpeg/ffmpeg.exe",
        "to": "Tools/ffmpeg/ffmpeg.exe"
      },
      {
        "from": "Tools/ffmpeg/ffprobe.exe",
        "to": "Tools/ffmpeg/ffprobe.exe"
      },
      {
        "from": "Tools/yt-dlp/yt-dlp.exe",
        "to": "Tools/yt-dlp/yt-dlp.exe"
      },
      {
        "from": "Tools/whisper",
        "to": "Tools/whisper",
        "filter": [
          "whisper-cli.exe",
          "whisper.dll",
          "ggml.dll",
          "ggml-base.dll",
          "ggml-cpu.dll"
        ]
      },
      {
        "from": "Tools/models/ggml-large-v2-q5_k.bin",
        "to": "Tools/models/ggml-large-v2-q5_k.bin"
      },
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/app-icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "useZip": true,
      "differentialPackage": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true,
      "shortcutName": "My Sesi Metne Dönüştürme",
      "uninstallDisplayName": "My Sesi Metne Dönüştürme"
    }
  }
}
