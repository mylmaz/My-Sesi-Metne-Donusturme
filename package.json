{
  "name": "my-sesi-metne-donusturme",
  "version": "1.1.0",
  "description": "My Sesi Metne Donusturme - yerel ses/video/YouTube transkript uygulaması",
  "author": "Mustafa Yılmaz",
  "copyright": "© 2026 Mustafa Yılmaz. Tüm hakları saklıdır.",
  "license": "MIT",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && set ELECTRON_RUN_AS_NODE=&& set VITE_DEV_SERVER_URL=http://127.0.0.1:5173&& electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "test:electron": "npm run build && set ELECTRON_RUN_AS_NODE=&& electron scripts/electron-smoke.cjs",
    "test:unit": "tsc -p tsconfig.electron.json && node --test src/renderer/presentation.test.cjs scripts/transcription.test.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "tools:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-tools.ps1",
    "tools:validate": "node scripts/validate-tools.cjs"
  },
  "dependencies": {
    "docx": "^9.1.1",
    "pdfkit": "^0.15.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.2",
    "electron-builder": "26.17.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "allowMissingDependencies": false,
    "appId": "com.mustafayilmaz.mysesimetnedonusturme",
    "productName": "My Sesi Metne Donusturme",
    "artifactName": "My-Sesi-Metne-Donusturme-Setup-x64.${ext}",
    "directories": {
      "output": "dist-electron-package"
    },
    "compression": "normal",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "Tools/ffmpeg",
        "to": "Tools/ffmpeg",
        "filter": [
          "*.exe",
          "*.dll"
        ]
      },
      {
        "from": "Tools/yt-dlp",
        "to": "Tools/yt-dlp",
        "filter": [
          "yt-dlp.exe"
        ]
      },
      {
        "from": "Tools/deno",
        "to": "Tools/deno",
        "filter": [
          "deno.exe"
        ]
      },
      {
        "from": "Tools/whisper",
        "to": "Tools/whisper",
        "filter": [
          "whisper-cli.exe",
          "*.dll"
        ]
      },
      {
        "from": "Tools/models/ggml-large-v2-q5_0.bin",
        "to": "Tools/models/ggml-large-v2-q5_0.bin"
      },
      {
        "from": "Tools/licenses",
        "to": "Tools/licenses"
      },
      {
        "from": "Tools/runtime-manifest.json",
        "to": "Tools/runtime-manifest.json"
      },
      {
        "from": "Tools/tools-lock.json",
        "to": "Tools/tools-lock.json"
      },
      {
        "from": "Tools/THIRD_PARTY_NOTICES.md",
        "to": "Tools/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "Tools/ffmpeg-sources.json",
        "to": "Tools/ffmpeg-sources.json"
      },
      {
        "from": "Tools/README.md",
        "to": "Tools/README.md"
      },
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/app-icon.ico",
      "executableName": "MySesiMetneDonusturme",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "include": "installer/electron-cleanup.nsh",
      "useZip": true,
      "differentialPackage": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "My Sesi Metne Donusturme",
      "uninstallDisplayName": "My Sesi Metne Donusturme",
      "runAfterFinish": true,
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ]
    },
    "beforePack": "./scripts/validate-tools.cjs",
    "afterPack": "./scripts/validate-packaged-tools.cjs",
    "afterAllArtifactBuild": "./scripts/copy-installer.cjs"
  }
}
